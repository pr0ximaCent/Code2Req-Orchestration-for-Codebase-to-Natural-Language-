{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix_output/packed.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 10
  },
  "include": [
    "**/*.py",
    "**/*.ipynb",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.vue",
    "**/*.svelte",
    "**/*.java",
    "**/*.kt",
    "**/*.scala",
    "**/*.go",
    "**/*.rs",
    "**/*.rb",
    "**/*.php",
    "**/*.cs",
    "**/*.c",
    "**/*.h",
    "**/*.cpp",
    "**/*.hpp",
    "**/*.swift",
    "**/*.dart",
    "**/*.proto",
    "**/*.graphql",
    "**/*.sql",
    "**/*.prisma",
    "**/*.tf",
    "**/*.sh",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.xml",
    "**/*.gradle",
    "**/Dockerfile",
    "**/Makefile",
    "**/requirements.txt",
    "**/README.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.git/**",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/*.pyc",
      "**/__pycache__/**",
      "**/*.h5",
      "**/*.pt",
      "**/*.pth",
      "**/*.onnx",
      "**/*.pkl",
      "**/*.bin",
      "**/*.sqlite3",
      "**/*.csv",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.ico",
      "**/*.webp",
      "**/*.css",
      "**/*.min.js",
      "**/*.map"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
