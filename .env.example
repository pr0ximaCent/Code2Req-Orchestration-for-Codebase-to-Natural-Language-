# code2req configuration
# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is git-ignored. Never commit real keys.
# code2req reads ./.env automatically, or the file given with --env-file.

# --- Gemini (required for the default model chain) -------------------------
# Get a key at https://aistudio.google.com/apikey
# A paid-tier key is recommended: free-tier keys hit the daily Gemini Pro
# quota after a few modules and the run falls back to Flash.
GEMINI_API_KEY=

# Optional: comma-separated pool of keys, used only when GEMINI_API_KEY is empty.
# Keys are rotated; invalid or exhausted ones are skipped for the rest of the run.
# GEMINI_API_KEYS=key1,key2,key3

# --- Azure OpenAI (optional fallback after Gemini Pro and Flash fail) ---------
# Each model is used only when all three of its values are set.
# AZURE_OPENAI_5_4_API_KEY=
# AZURE_OPENAI_5_4_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_5_4_API_VERSION=

# AZURE_OPENAI_5_5_API_KEY=
# AZURE_OPENAI_5_5_ENDPOINT=
# AZURE_OPENAI_5_5_API_VERSION=

# AZURE_OPENAI_5_6_TERRA_API_KEY=
# AZURE_OPENAI_5_6_TERRA_ENDPOINT=
# AZURE_OPENAI_5_6_TERRA_API_VERSION=

# --- Using one model instead of the chain (optional) -------------------------
# Any LiteLLM model string, e.g. anthropic/<model> or openai/<model>.
# Same as passing --model. Set the matching provider key below.
# CODE2REQ_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
