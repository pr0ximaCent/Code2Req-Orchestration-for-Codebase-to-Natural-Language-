    msgs = chat.LoadHistory(user, thread, depth+1) !err -> log.error, fail
    t = transcript(msgs)  t=="" -> log.warn, return ""  # no context, so no LLM call
    r = llm.LITE(prompt{msg.trim, t}) !err -> fail
    return trim(r)
  transcript(msgs)  @:51-97
    each m !in current, user|ai != "":
      user line: trunc(user)
      attachments line: names
      ai line: trunc(text + [action file])
  trunc(s) = len(s)<=turnMax -> s; s[:turnMax] + " …[truncated]"  @:99-104
