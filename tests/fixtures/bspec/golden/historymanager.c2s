historymanager : Agent(route=history-manager, skipFollowUp)  @app/chatbot/agents/historymanager/spec.go
  when  message depends on earlier turns; never answers the user
  cfg   depth=5, turnMax=4000B
  run(request) = h = recoverContext(prompt); return reroute(h), err  @spec.go:26-29
