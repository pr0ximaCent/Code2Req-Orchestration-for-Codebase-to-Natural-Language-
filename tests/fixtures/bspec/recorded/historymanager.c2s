historymanager : Agent(route="history-manager", skipFollowUp)  @app/chatbot/agents/historymanager/spec.go
  when  the message only makes sense against something said earlier
  cfg   historyDepth=5, maxTurnChars=4000B
  !err -> fail
  Run(ctx, chatContext, userMessage) -> (string, error)  @agent.go:20-49
    messages = load history of depth+1 !err -> fail
    transcript = formatHistory(messages, currentMessageID)
    transcript == "" -> return ""
    filled = prompt with userMessage and transcript
    response = run LLM with filled !err -> fail
    return trimmed response
  run(ctx, request) -> (agent.Result, error)  @spec.go:26-29
    history = Run(ctx, request.ChatContext, request.Input.Prompt)
    return agent.Result(Reroute=true, History=history)
  truncate(text) -> string  @agent.go:99-104
    len(text) <= maxTurnChars -> return text
    return text[:maxTurnChars] + " …[truncated]"
  ? [encoding] @:103 string cut by bytes; can split a UTF-8 character
  ? [duplicated-constant] @prompts.go:6 historyDepth=5 also written as 5 in a string
  ? [mixed-result] @spec.go:28 returns a success value together with the error
